# Django
DJANGO_SECRET_KEY=replace-with-generated-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# PostgreSQL
POSTGRES_DB=kenya_flood_risk
POSTGRES_USER=kenya_flood_app
POSTGRES_PASSWORD=replace-with-local-database-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Final Random Forest release
MODEL_BUNDLE_PATH=models/final/kenya_flood_risk_rf_v1_0_0/kenya_flood_risk_rf_v1_0_0.joblib
MODEL_METADATA_PATH=models/final/kenya_flood_risk_rf_v1_0_0/model_metadata.json
MODEL_SCHEMA_PATH=models/final/kenya_flood_risk_rf_v1_0_0/model_input_schema.csv

# Alert delivery. Console output is safe for local development.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=Kenya Flood Risk Platform <alerts@example.com>
ALERT_EMAIL_RECIPIENTS=
IN_APP_ALERT_RECIPIENT=platform-users
OUTLOOK_ADVISORY_THRESHOLD=0.15
OUTLOOK_ADVISORY_CHANGE_THRESHOLD=0.05
